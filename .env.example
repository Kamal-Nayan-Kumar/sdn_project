# Trustworthy Agentic AI for Intent-Based Self-Healing SDN — env template.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- LLM (Groq) -----------------------------------------------------------
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# --- Database ------------------------------------------------------------
# Local PostgreSQL preferred. SQLite fallback for early prototyping only:
#   DATABASE_URL=sqlite+pysqlite:///./sdn_dev.db
DATABASE_URL=postgresql+psycopg://sdn_user:replace_password@localhost:5432/sdn_db

# --- API -----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Network lab ---------------------------------------------------------
# `real`  = talk to the actual Mininet/OVS/Ryu lab over the bridge
# `mock`  = clearly-labelled synthetic telemetry (test/dev only)
# The system MUST NOT silently downgrade real -> mock at runtime.
LAB_MODE=real
LAB_BRIDGE_URL=ws://127.0.0.1:8765
LAB_BRIDGE_TOKEN=replace_with_a_long_random_local_secret

# --- Trustworthiness policy ---------------------------------------------
MAX_EVIDENCE_RETRIES=2
MAX_RECOVERY_RETRIES=2
TELEMETRY_MAX_AGE_SECONDS=5
EVIDENCE_MIN_CONFIDENCE=0.6

# Link utilisation above this fraction of capacity is treated as congestion.
CONGESTION_UTILIZATION_THRESHOLD=0.8

# --- Proactive monitoring ------------------------------------------------
PROACTIVE_MONITOR_ENABLED=false
PROACTIVE_SAMPLE_INTERVAL_SECONDS=5
PROACTIVE_VIOLATION_COUNT=3
PROACTIVE_COOLDOWN_SECONDS=60

# --- Safety --------------------------------------------------------------
# When true, medium/high-risk actions wait for a human approval before they
# are executed. Low-risk allow-listed reroutes may still run unattended.
REQUIRE_HUMAN_APPROVAL_FOR_RISKY_ACTIONS=true
